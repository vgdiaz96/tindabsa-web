---
import '../styles/global.css';
const { title, description = 'TINDAB S.A. — Químicos y productos de limpieza institucional en Guayaquil, Ecuador. Limpieza ÑEQUE, hipoclorito de sodio al 10% y servicios de maquila.' } = Astro.props;
const WA = 'https://wa.me/593969361746';
const ruta = Astro.url.pathname;
const activo = (p) => ruta.startsWith(p) ? 'activo' : '';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} | TINDAB S.A.</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.ico" sizes="48x48" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" />
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "TINDAB S.A.",
    "slogan": "Tu negocio, nuestro compromiso",
    "telephone": "+593969361746",
    "email": "ventas@tindabsa.com",
    "url": "https://tindabsa.com",
    "address": { "@type": "PostalAddress", "addressLocality": "Guayaquil", "addressCountry": "EC" },
    "openingHours": "Mo-Fr 09:00-16:00"
  })} />
</head>
<body>
  <header class="site">
    <nav class="nav" aria-label="Navegación principal">
      <a href="/" class="logo"><span class="placa">T</span><strong>TINDAB</strong></a>
      <button class="menu-btn" aria-label="Abrir menú" onclick="document.querySelector('.links').classList.toggle('abierto')">☰</button>
      <div class="links">
        <a href="/nosotros/" class={activo('/nosotros')}>Nosotros</a>
        <a href="/limpieza-neque/" class={activo('/limpieza-neque')}>Limpieza ÑEQUE</a>
        <a href="/quimicos-industriales/" class={activo('/quimicos-industriales')}>Químicos industriales</a>
        <a href="/maquila/" class={activo('/maquila')}>Maquila</a>
        <a href="/blog/" class={activo('/blog')}>Blog</a>
        <a href="/contacto/" class={activo('/contacto')}>Contacto</a>
      </div>
      <a href="/contacto/" class="btn">Cotizar</a>
    </nav>
  </header>

  <main>
    <slot />
  </main>

  <footer class="site">
    <div class="container cols">
      <div>
        <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
          <span class="placa">T</span><strong style="color:#FFF;letter-spacing:1.5px">TINDAB</strong>
        </div>
        <p>Tu negocio, nuestro compromiso</p>
        <p style="margin-top:8px;font-size:.8rem">Químicos y productos de limpieza institucional. Guayaquil, Ecuador. Desde 2014.</p>
      </div>
      <div>
        <p><strong style="color:#FFF">Contacto</strong></p>
        <p><a href="mailto:ventas@tindabsa.com">ventas@tindabsa.com</a></p>
        <p><a href={WA}>+593 96 936 1746 (WhatsApp)</a></p>
        <p><a href="tel:+59342980395">04 298 0395</a></p>
        <p>Lunes a viernes, 9:00–16:00</p>
      </div>
      <div>
        <p><strong style="color:#FFF">Síguenos</strong></p>
        <p><a href="https://instagram.com/tindabsa" rel="noopener">Instagram @tindabsa</a></p>
        <p><a href="https://facebook.com/tindabsa" rel="noopener">Facebook @tindabsa</a></p>
        <p style="margin-top:10px">© 2026 TINDAB S.A.</p>
      </div>
    </div>
  </footer>

  <a class="wa-float" href={WA} aria-label="Escríbenos por WhatsApp" rel="noopener">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-2-1.2 7.5 7.5 0 0 1-1.4-1.7c-.1-.2 0-.4.1-.5l.4-.5a1.8 1.8 0 0 0 .3-.4.5.5 0 0 0 0-.4c0-.1-.6-1.4-.8-1.9s-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 2.9 2.9 0 0 0-.9 2.2 5 5 0 0 0 1 2.7 11.4 11.4 0 0 0 4.4 3.9 14.9 14.9 0 0 0 1.5.5 3.6 3.6 0 0 0 1.6.1 2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .2-1.3c-.1-.1-.3-.2-.6-.3Z"/></svg>
  </a>
</body>
</html>
