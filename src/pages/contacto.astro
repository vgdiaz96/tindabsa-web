---
import Base from '../layouts/Base.astro';
import Cotizador from '../components/Cotizador.astro';
const WA = `https://wa.me/593969361746?text=${encodeURIComponent('Hola TINDAB, quiero una cotización.\nEmpresa o negocio: \nCiudad: \nProducto y cantidad al mes: ')}`;
---
<Base title="Contacto y cotizaciones" description="Solicita tu cotización a TINDAB S.A.: productos de limpieza ÑEQUE, hipoclorito de sodio y servicios de maquila. WhatsApp +593 96 936 1746 · ventas@tindabsa.com · Guayaquil, Ecuador.">

  <div class="container">
    <div class="breadcrumb"><a href="/">Inicio</a> / Contacto</div>
    <h1>Solicita tu cotización</h1>
    <p style="color:var(--texto3);margin:8px 0 28px">Responde 4 preguntas rápidas y te enviamos una cotización a la medida de tu negocio. Atendemos de lunes a viernes, de 9:00 a 16:00.</p>

    <div style="display:grid;grid-template-columns:1.25fr .75fr;gap:32px;align-items:start" id="contacto-grid">
      <div>
        <Cotizador />
      </div>

      <div style="display:flex;flex-direction:column;gap:14px">
        <div class="card">
          <h3>WhatsApp (más rápido)</h3>
          <p style="color:var(--texto3);font-size:.9rem;margin:4px 0 12px">Escríbenos directo. Para atenderte más rápido, indícanos tu empresa, ciudad y cantidad que necesitas al mes.</p>
          <a href={WA} class="btn-wa" rel="noopener">+593 96 936 1746</a>
        </div>
        <div class="card">
          <h3>Otros canales</h3>
          <p style="font-size:.92rem;color:var(--texto2);margin-top:6px">
            <a href="mailto:ventas@tindabsa.com" style="color:var(--azul2);font-weight:600">ventas@tindabsa.com</a><br />
            Fijo: <a href="tel:+59342980395">04 298 0395</a><br />
            Instagram y Facebook: @tindabsa<br />
            Guayaquil, Ecuador · 9:00–16:00
          </p>
        </div>
      </div>
    </div>
  </div>


  <style>
    @media (max-width: 860px) { #contacto-grid { grid-template-columns: 1fr !important; } }
  </style>

</Base>
