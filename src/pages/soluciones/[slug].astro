---
import Base from '../../layouts/Base.astro';
import Cotizador from '../../components/Cotizador.astro';
import segmentos from '../../data/segmentos.json';
import productos from '../../data/productos.json';

export function getStaticPaths() {
  return segmentos.map(s => ({ params: { slug: s.slug }, props: { s } }));
}
const { s } = Astro.props;
const recomendados = s.productos.map(slug => productos.find(p => p.slug === slug)).filter(Boolean);
const WA = `https://wa.me/593969361746?text=${encodeURIComponent(`Hola TINDAB, vi la página de ${s.menu.toLowerCase()} y quiero una cotización.\nEmpresa o negocio: \nCiudad: \nProductos y cantidad al mes: `)}`;
const url = new URL(Astro.url.pathname, Astro.site).href;
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": s.faq.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://tindabsa.com/" },
      { "@type": "ListItem", "position": 2, "name": "Soluciones", "item": "https://tindabsa.com/soluciones/" },
      { "@type": "ListItem", "position": 3, "name": s.menu, "item": url },
    ],
  },
];
---
<Base title={s.title} description={s.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="hero">
    <div class="container" style="max-width:860px">
      <div class="breadcrumb" style="padding-top:0"><a href="/">Inicio</a> / <a href="/soluciones/">Soluciones</a> / {s.menu}</div>
      <p class="kicker">{s.kicker}</p>
      <h1>{s.h1}</h1>
      <p class="lead">{s.intro}</p>
      <div class="cta-row">
        <a href="#cotizar" class="btn">Solicitar cotización</a>
        <a href={WA} class="btn-wa" rel="noopener">WhatsApp</a>
      </div>
    </div>
  </div>

  {s.dolores && (
    <section class="bloque">
      <div class="container">
        <h2 style="text-align:center;margin-bottom:24px">Lo que resolvemos</h2>
        <div class="seg-dolores">
          {s.dolores.map(d => (
            <div class="card"><h3>{d.t}</h3><p>{d.d}</p></div>
          ))}
        </div>
      </div>
    </section>
  )}

  {s.pasos && (
    <section class="bloque">
      <div class="container">
        <h2 style="text-align:center;margin-bottom:24px">Cómo funciona</h2>
        <div class="grid-4">
          {s.pasos.map((p, i) => (
            <div class="card"><span class="num" style="margin-bottom:10px">{i + 1}</span><h3>{p.t}</h3><p style="color:var(--texto3);font-size:.9rem;margin-top:4px">{p.d}</p></div>
          ))}
        </div>
      </div>
    </section>
  )}

  {s.reparto && (
    <section class="bloque">
      <div class="container">
        <h2 style="text-align:center;margin-bottom:24px">Qué ponemos nosotros y qué pones tú</h2>
        <div class="reparto">
          <div class="card"><h3>TINDAB</h3><ul>{s.reparto.nosotros.map(x => <li>{x}</li>)}</ul></div>
          <div class="card"><h3>Tú</h3><ul>{s.reparto.tu.map(x => <li>{x}</li>)}</ul></div>
        </div>
      </div>
    </section>
  )}

  {recomendados.length > 0 && (
    <section class="bloque">
      <div class="container">
        <h2 style="margin-bottom:20px">{s.productosTitulo || 'Productos recomendados'}</h2>
        <div class="grid-4">
          {recomendados.map(p => (
            <a class="pcard" href={`/limpieza-neque/${p.slug}/`}>
              <div class="foto" style="height:160px">{p.fotos ? <img src={p.fotos[0]} alt={`${p.nombre} ÑEQUE`} loading="lazy" width="400" height="400" /> : 'Foto'}</div>
              <div class="info"><div class="nombre">{p.nombre}</div><div class="det">{p.presentaciones.join(' / ')}</div></div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="bloque">
    <div class="container" style="max-width:820px">
      <h2 style="margin-bottom:16px">Preguntas frecuentes</h2>
      <div class="faq">
        {s.faq.map(f => (
          <details><summary>{f.q}</summary><p>{f.a}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="bloque" id="cotizar">
    <div class="container" style="max-width:820px">
      <h2 style="text-align:center;margin-bottom:6px">Pide tu cotización</h2>
      <p style="text-align:center;color:var(--texto3);margin-bottom:18px">4 preguntas rápidas y te respondemos con una propuesta para tu negocio.</p>
      <Cotizador tema={s.tema} segmento={s.segmento} />
    </div>
  </section>
</Base>
